# Másold .env néven (a .env NINCS verziókezelve) – vagy állítsd be közvetlenül környezeti változóként.
# A szerver NEM tölti be automatikusan a .env-et; helyben pl.:  set -a; . ./.env; set +a; npm start

# HTTP port. Renderen a platform állítja be (ne írd felül).
PORT=3000

# PostgreSQL kapcsolat. Ha üres / hiányzik -> memóriabeli ranglista (újraindításkor törlődik!).
# A Kománovics-játékok egy KÖZÖS adatbázison osztozhatnak; mindegyik saját táblát használ.
# Renderen: a Render Postgres "Internal Database URL"-je (Dashboardon / MCP-n állítva, SOHA nem commitolva).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# A pontszám-tábla neve a közös adatbázisban. Alapértelmezés: darts_scores
# (csak kisbetű, szám, aláhúzás; a tábla induláskor automatikusan létrejön).
SCORES_TABLE=

# SSL a Postgreshez: "true" | "false" | üres (=automatikus: *.render.com külső host -> SSL).
DATABASE_SSL=

# Rate limit: max ennyi pontszám-beküldés IP-nként egy percben (alapértelmezés: 5).
SCORE_RATE_LIMIT_PER_MIN=5
